#PASSING AN ARBITRARY NUMBER IN FUNCTION
# USING '*' IN PARAMETER
def make_pizza(*toppings):
    """Making a pizza with the following toppings."""
    print("\nMaking the pizza with the following toppings: ")
    for topping in toppings:
        print(f" - {topping}")

make_pizza('peperoni')
make_pizza('peperoni','cheese','mushrooms')

#Using Arbitrary keywords Argument

def build_profile(first, last, **user_info):
    """Build a dict for containing the user information."""
    user_info['first_name'] = first
    user_info['last_name'] = last
    return user_info

user_profile = build_profile('albert', 'einstein',
                             location='princeton',
                             field='physics')
print(user_profile)

