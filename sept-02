def get_greeting():
  return "Hello from a function."

message = get_greeting()
print(message)

#### parameters vs arguments

def my_fun(name):  #this is parameter 
  print("Hello" , name)

my_fun("Emil") #this is arguments

#default parameter

def my_function(name = "friend"):
  print("Hello", name)

my_function("Emil")
my_function("Tobias")
my_function()
my_function("Linus")

## keyword arguments

def my_pet(animal,name):
  print("I have a", animal)
  print("His name is", name)

my_pet(name="effy",animal="dog")

#positional arguments

def my_anim(animal,name,age):
  print("I have a" , animal, "his name is", name , "he is old", age)

my_anim("dog",name="nammy",age=4)

### passing different data types 

def fruit_fun(fruits):
  for fruit in fruits:
    print(fruit)

my_fruits = ['apple',"cherry",'banana']
fruit_fun(my_fruits)

