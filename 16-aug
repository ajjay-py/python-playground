#union () - add both sets

s1 = {'a','b','c'}
s2 = {1,2,3}
s3 = s1.union(s2)
print(s3)

s4 = s1 | s2 # | it also joins the sets
print(s4)

#join multiple sets 

set1 = {"a", "b", "c"}
set2 = {1, 2, 3}
set3 = {"John", "Elena"}
set4 = {"apple", "bananas", "cherry"}

myset = set1.union(set2, set3, set4)
print(myset)

#join another type of data type with union 

x = {"a", "b", "c"}
y = (1, 2, 3)

z = x.union(y)
print(z)

#update - insert items from one set to another 

set1 = {"a", "b" , "c"}
set2 = {1, 2, 3}

set1.update(set2)
print(set1)

#intersection - will return only the items which are present in both the set

set1 = {'ajay','pashu','sourabh',1}
set2 = {1,2,3,'ajay'}

set3 = set1.intersection(set2)
print(set3)

set4 = set1 & set2 # & is used instead the intersection
print(set4)


# intersection_update() it will only keep the duplicats but change the original set also

set1.intersection_update(set2)
print(set1)

print(set2)

# True and 1, False and 0 consider as same 
s1 = {"apple", 1,  "banana", 0, "cherry"}
s2 = {False, "google", 1, "apple", 2, True}

s3 = s1.intersection(s2)

print(s3)

#difference() will return the value which is present in first set and are not present in other set
s3 = s1.difference(s2)
print(s3)

s3 = s2 - s1
print(s3)

#difference_update() - keep items from first set ,and are not present in other set 

set1 = {"apple", "banana", "cherry"}
set2 = {"google", "microsoft", "apple"}

set1.difference_update(set2)

print(set1)

#symmetric_difference() - keep only the item which are not present in both the sets
set1 = {"apple", "banana", "cherry"}
set2 = {"google", "microsoft", "apple"}

set3 = set1.symmetric_difference(set2)

print(set3)

# use ^ sign for symmetric_difference()

print(set1 ^ set2)


