def print_models(unprinted_models, completed_models):
    """Defining to the all models that are printed."""

    while unprinted_models:
        current_models = unprinted_models.pop()
        print(f"Currntly printing: {current_models}")
        completed_models.append(current_models)

def show_completed_models(completed_models):
    """Display all the complted designs."""

    print(f"\nThe completed designs are below: ")
    for completed_model in completed_models:
        print(completed_model)


