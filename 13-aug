##unpacking tuple - extract the value back to the variable

nato = ('alpha','bravo','charlie')
(a,b,c) = nato #unpacking

print(a)
print(b)
print(c)

#using * 
nato1 = ('alpha','bravo','charlie','delta','echo')
(a,b,*c) = nato1
print(a)
print(b)
print(c)

# using * at middle
fruits = ("apple", "mango", "papaya", "pineapple", "cherry")

(green, *tropic, red) = fruits

print(green)
print(tropic)
print(red)

